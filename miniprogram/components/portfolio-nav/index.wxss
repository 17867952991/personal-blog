.nav-wrap { position: absolute; z-index: 2; top: 40rpx; right: 0; left: 0; display: flex; justify-content: center; }
.nav-panel { display: flex; align-items: center; gap: 28rpx; padding: 16rpx 24rpx; border: 1rpx solid rgba(255,255,255,.72); border-radius: 24rpx; background: rgba(255,255,255,.72); box-shadow: 0 12rpx 34rpx rgba(27,19,60,.1); }
.brand { display: grid; width: 44rpx; height: 44rpx; border-radius: 12rpx; place-items: center; background: #1b133c; color: #fff; font-family: Georgia, serif; font-weight: 700; }
.nav-links { display: flex; gap: 24rpx; color: rgba(27,19,60,.78); font-size: 24rpx; }
