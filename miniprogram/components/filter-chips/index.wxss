.chips { display: flex; flex-wrap: wrap; gap: 14rpx; }
.chip { margin: 0; padding: 0 28rpx; border: 1rpx solid rgba(27,19,60,.12); border-radius: 16rpx; background: rgba(255,255,255,.7); color: rgba(27,19,60,.75); font-size: 25rpx; line-height: 68rpx; }
.chip-active { border-color: #1b133c; background: #1b133c; color: #fff; box-shadow: 0 10rpx 24rpx rgba(27,19,60,.16); }
