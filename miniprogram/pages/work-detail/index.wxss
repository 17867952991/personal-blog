.detail-page { min-height: 100vh; padding: 48rpx 32rpx 80rpx; background: #f7f7fb; }
.detail-header { display: flex; margin-bottom: 36rpx; flex-direction: column; }
.work-meta { color: rgba(27,19,60,.6); font-size: 25rpx; }
.work-title, .missing-title { margin-top: 14rpx; font-family: Georgia, "Songti SC", serif; font-size: 64rpx; font-weight: 700; line-height: 1.1; }
.video-panel, .detail-card { overflow: hidden; margin-top: 26rpx; border: 1rpx solid rgba(27,19,60,.1); border-radius: 22rpx; background: rgba(255,255,255,.76); box-shadow: 0 16rpx 44rpx rgba(27,19,60,.08); }
.work-video { display: block; width: 100%; height: 390rpx; background: #08070f; }
.detail-card { display: flex; padding: 32rpx; flex-direction: column; }
.card-title { font-size: 29rpx; font-weight: 700; }
.detail-rows { display: flex; margin-top: 24rpx; flex-direction: column; gap: 14rpx; }
.detail-row { display: grid; padding: 18rpx; grid-template-columns: 160rpx 1fr; gap: 16rpx; border-radius: 14rpx; background: #f7f7fb; font-size: 26rpx; }
.row-label { color: rgba(27,19,60,.58); font-weight: 700; }
.card-copy { margin-top: 20rpx; color: rgba(27,19,60,.72); font-size: 27rpx; line-height: 1.8; }
.director-note { margin-top: 20rpx; font-family: Georgia, "Songti SC", serif; font-size: 38rpx; font-style: italic; line-height: 1.35; }
.archive-grid { display: grid; margin-top: 28rpx; grid-template-columns: repeat(2, 1fr); gap: 18rpx; }
.archive-image { width: 100%; height: 240rpx; border-radius: 16rpx; }
.tag-list { display: flex; margin-top: 28rpx; flex-wrap: wrap; gap: 12rpx; }
.tag { padding: 10rpx 18rpx; border-radius: 14rpx; background: #eeeaf6; color: rgba(27,19,60,.76); font-size: 23rpx; }
.missing-state { display: flex; min-height: 70vh; align-items: center; justify-content: center; flex-direction: column; text-align: center; }
.missing-copy { margin-top: 24rpx; color: rgba(27,19,60,.65); font-size: 28rpx; }
.home-button { margin-top: 40rpx; padding: 0 42rpx; border-radius: 16rpx; background: #1b133c; color: #fff; font-size: 27rpx; line-height: 82rpx; }
